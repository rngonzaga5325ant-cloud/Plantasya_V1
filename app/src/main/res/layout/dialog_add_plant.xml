<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    android:layout_margin="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add a New Plant"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:fontFamily="@font/crimsontext_bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:id="@+id/btnScanOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/tbx_container"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_cam_logo"
                app:tint="@color/btn_c" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Scan a Plant"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:fontFamily="@font/crimsontext_regular" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnLibraryOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/tbx_container"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_library_logo"
                app:tint="@color/btn_c" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Browse Library"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:fontFamily="@font/crimsontext_regular" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
