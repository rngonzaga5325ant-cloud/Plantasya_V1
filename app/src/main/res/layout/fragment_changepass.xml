<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    tools:context=".ChangePass">

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="400dp"
        android:layout_height="509dp"
        android:src="@drawable/background_tree"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.28" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/fustat_semb"
        android:text="Update Credentials"
        android:textColor="@color/black"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardCredentials"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@color/white">

            <EditText
                android:id="@+id/etCurrentUsername"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/tbx_container"
                android:fontFamily="@font/crimsontext_regular"
                android:hint="Current Username"
                android:inputType="text"
                android:paddingStart="16dp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etNewUsername"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/tbx_container"
                android:fontFamily="@font/crimsontext_regular"
                android:hint="New Username"
                android:inputType="text"
                android:paddingStart="16dp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etCurrentPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/tbx_container"
                android:fontFamily="@font/crimsontext_regular"
                android:hint="Current Password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/tbx_container"
                android:fontFamily="@font/crimsontext_regular"
                android:hint="New Password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:textColor="@color/black"
                android:textColorHint="@color/black"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnSaveChanges"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/btn_c"
        android:fontFamily="@font/crimsontext_bold"
        android:text="Save Changes"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="@+id/cardCredentials"
        app:layout_constraintStart_toStartOf="@+id/cardCredentials"
        app:layout_constraintTop_toBottomOf="@+id/cardCredentials" />

</androidx.constraintlayout.widget.ConstraintLayout>
