<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_rounded">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOverduePlantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/crimsontext_bold"
            android:textColor="#D32F2F"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvOverdueTaskName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/crimsontext_regular"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvOverdueDueTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/crimsontext_regular"
            android:textColor="#888888"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnQuickComplete"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Complete"
        android:textSize="12sp"
        android:backgroundTint="@color/btn_c"
        android:textColor="@color/white"
        android:paddingHorizontal="12dp" />

</LinearLayout>
